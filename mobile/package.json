{
  "name": "mipc-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && expo export --platform ios --output-dir dist-ios && expo export --platform android --output-dir dist-android"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~57.0.8",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
